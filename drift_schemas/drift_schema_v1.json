  "fixed_sql": [
    {
      "name": "conversations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"conversations\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"assistant_id\" TEXT NULL, \"is_pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_pinned\" IN (0, 1)), \"truncate_index\" INTEGER NOT NULL DEFAULT -1, \"compact_before_index\" INTEGER NOT NULL DEFAULT -1, \"summary\" TEXT NULL, \"last_summarized_message_count\" INTEGER NOT NULL DEFAULT 0, \"mcp_server_ids_json\" TEXT NOT NULL DEFAULT '[]', \"version_selections_json\" TEXT NOT NULL DEFAULT '{}', \"is_recovered\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_recovered\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "messages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"messages\" (\"id\" TEXT NOT NULL, \"conversation_id\" TEXT NOT NULL REFERENCES conversations (id) ON DELETE CASCADE, \"ordinal\" INTEGER NOT NULL, \"role\" TEXT NOT NULL, \"content\" TEXT NOT NULL, \"timestamp\" INTEGER NOT NULL, \"model_id\" TEXT NULL, \"provider_id\" TEXT NULL, \"total_tokens\" INTEGER NULL, \"prompt_tokens\" INTEGER NULL, \"completion_tokens\" INTEGER NULL, \"cached_tokens\" INTEGER NULL, \"is_streaming\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_streaming\" IN (0, 1)), \"reasoning_text\" TEXT NULL, \"reasoning_start_at\" INTEGER NULL, \"reasoning_finished_at\" INTEGER NULL, \"translation\" TEXT NULL, \"reasoning_segments_json\" TEXT NULL, \"group_id\" TEXT NULL, \"version\" INTEGER NOT NULL DEFAULT 0, \"ai_team_proposals_json\" TEXT NULL, \"process_started_at\" INTEGER NULL, \"process_finished_at\" INTEGER NULL, PRIMARY KEY (\"id\"), UNIQUE (conversation_id, ordinal));"
        }
      ]
    },
    {
      "name": "message_parts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"message_parts\" (\"part_id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"message_id\" TEXT NOT NULL REFERENCES messages (id) ON DELETE CASCADE, \"ordinal\" INTEGER NOT NULL, \"kind\" TEXT NOT NULL, \"tool_call_id\" TEXT NULL, \"tool_name\" TEXT NULL, \"arguments_json\" TEXT NULL, \"content\" TEXT NULL, \"status\" TEXT NOT NULL DEFAULT 'pending', \"approval_state\" TEXT NULL, \"metadata_json\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, CHECK (status IN ('pending', 'completed', 'interrupted', 'denied')), CHECK (status <> 'completed' OR content IS NOT NULL));"
        }
      ]
    },
    {
      "name": "provider_artifacts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"provider_artifacts\" (\"message_id\" TEXT NOT NULL REFERENCES messages (id) ON DELETE CASCADE, \"kind\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"message_id\", \"kind\"));"
        }
      ]
    },
    {
      "name": "message_file_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"message_file_records\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"message_id\" TEXT NOT NULL REFERENCES messages (id) ON DELETE CASCADE, \"ordinal\" INTEGER NOT NULL, \"path\" TEXT NOT NULL, \"file_name\" TEXT NULL, \"size_bytes\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, UNIQUE (message_id, path));"
        }
      ]
    },
    {
      "name": "conversation_workspace_bindings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"conversation_workspace_bindings\" (\"conversation_id\" TEXT NOT NULL REFERENCES conversations (id) ON DELETE CASCADE, \"config_json\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"conversation_id\"));"
        }
      ]
    },
    {
      "name": "migration_meta",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"migration_meta\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
